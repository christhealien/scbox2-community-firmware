#!/bin/sh
# scbox2: this miner's own random seed, kept on the settings partition. The read-only system image's
# /etc/random-seed is the same file on every unit (and can't be rewritten), so it isn't used.
#
#   load   S38initdir, right after the settings are mounted (before the network, SSH and the panel start): mixes the
#          saved seed and some of this unit's own state into the kernel's pool, then saves a fresh seed at once,
#          so a seed is never used twice (not even after a power cut).
#   save   S20urandom at shutdown: a fresh 512-byte seed from the pool.
#
# The settings are a RAM copy (/mnt/config) of a partition that is read-only while the miner runs (v0.5.2, see
# /usr/libexec/scbox2/cfgmount): the seed is written there, then saved onto the partition in a short write window
# (/usr/libexec/scbox2/cfgwrite). That is once at boot and once at shutdown: nothing while the miner runs (before
# v0.5.2 a fresh seed was also saved every 6 hours).
#
# Mixing data into /dev/urandom doesn't credit entropy, so it can only help; the panel still waits for the pool
# (/dev/random readable) before it makes a key that lasts (access.go).
SEED=${SCBOX2_SEED:-/mnt/config/random-seed}
SAVE=${SCBOX2_CFGWRITE:-/usr/libexec/scbox2/cfgwrite}
# (top level, not in /mnt/config/scbox2: S48's one-time move of an old settings dir needs that dir absent)

save() {
	if ( umask 077; dd if=/dev/urandom of="$SEED.tmp" bs=512 count=1 ) >/dev/null 2>&1 &&
		mv -f "$SEED.tmp" "$SEED" 2>/dev/null; then
		$SAVE "${SEED#/mnt/config/}" 2>/dev/null
		return
	fi
	rm -f "$SEED.tmp" 2>/dev/null
	return 1
}

case "$1" in
load)
	if [ -s "$SEED" ]; then
		cat "$SEED" > /dev/urandom 2>/dev/null && echo "scbox2: random seed loaded"
	else
		echo "scbox2: no saved random seed yet (first start)"
	fi
	# this unit's own state as well (its MAC, interrupt counts, uptime): different on every unit and boot
	cat /sys/class/net/*/address /proc/interrupts /proc/stat /proc/uptime > /dev/urandom 2>/dev/null
	save || echo "scbox2: WARNING could not save a new random seed"
	;;
save)
	save
	;;
loop)
	exit 0 # (v0.5.1 and older: a fresh seed every 6 hours; not any more, see above)
	;;
*)
	echo "Usage: $0 {load|save}" >&2
	exit 1
	;;
esac
exit 0
